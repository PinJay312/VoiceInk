    "VoiceInk is private by default. No data leaves your device unless you opt in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk ist standardmäßig privat. Keine Daten verlassen dein Gerät, sofern du dem nicht zustimmst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk est privé par défaut. Aucune donnée ne quitte votre appareil à moins que vous ne vous y inscriviez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 默认保护隐私。除非你主动选择，否则任何数据都不会离开你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 預設保護隱私。除非你主動選擇，否則任何資料都不會離開你的裝置。"
          }
        },
        "zh-TW": {
