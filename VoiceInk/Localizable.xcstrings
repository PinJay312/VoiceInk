        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併"
          }
        },
        "zh-TW": {
